{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        "icons/**",
        "src/_icons/**"
    ],
    "tasks": {
        "build": {
            "outputs": [
                "dist/**",
                "icons/**",
                "provider-nodes.json",
                "provider-sprite.svg",
                "sources-nodes.json",
                "sources-sprite.svg"
            ],
            "dependsOn": ["^build"]
        },
        "lint": { },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "test": {
            "dependsOn": ["^test"]
        }
    }
}